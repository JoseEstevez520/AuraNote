# Copia este archivo a .env y rellena las claves. El .env nunca se sube
# (lo bloquea .gitignore). Todas las VITE_* llegan al navegador en dev; en
# producción vivirían tras un backend. Aquí van solo nombres, nunca valores.

# Modelo grande — genera secciones y artefactos (gpt-4.1)
VITE_LLM_API_KEY=
VITE_LLM_MODEL=
VITE_LLM_BASE_URL=

# Router — decide sección vs. artefacto (gpt-4.1-mini)
VITE_ROUTER_MODEL=

# Mapas iOS (Stadia, Alidade Smooth). Sin key: respaldo Esri
VITE_STADIA_KEY=

# Fotos en secciones y artefactos (Unsplash)
VITE_UNSPLASH_KEY=

# OmniSVG en dev (texto→SVG). Solo servidor, nunca llega al navegador
HF_TOKEN=
